# Modèle de configuration backend — VERSIONNÉ.
# Copier ce fichier en `.env` (`cp .env.example .env`) puis adapter si besoin.
# Les valeurs par défaut correspondent au service MySQL de docker-compose.yml.

PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=cybertwin
DB_PASSWORD=cybertwin
DB_NAME=cybertwin

# Identifiants root — utilisés UNIQUEMENT par `npm run db:init`
# (le schema.sql fait DROP/CREATE DATABASE, ce qui exige les droits root).
DB_ROOT_USER=root
DB_ROOT_PASSWORD=root
